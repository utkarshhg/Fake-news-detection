# ── Fake News Detection — Environment Variables ─────────────────
# Copy this file to .env and fill in your values.

# Secret key for session/auth token signing (change this in production!)
SECRET_KEY=change-me-to-a-random-string

# Initial admin account (created on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@fakenews.local

# NewsAPI.org key for real-time verification (free tier: 100 req/day)
# Get one at https://newsapi.org/register
NEWS_API_KEY=

# Database URL (default: SQLite in project root)
# For PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///fake_news.db

# Streamlit server config
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ── DagsHub / MLflow Tracking ─────────────────────────────────
# To log metrics remotely to DagsHub, provide your API token.
# MLflow URI: https://dagshub.com/utkarshhg/Fake-news-detection.mlflow
DAGSHUB_USER_TOKEN=your-dagshub-api-token
MLFLOW_TRACKING_USERNAME=utkarshhg
MLFLOW_TRACKING_PASSWORD=your-dagshub-api-token
